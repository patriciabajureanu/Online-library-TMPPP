@{
     ViewBag.Title = "Create User Loan";
     Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5 my-5">
     <div class="container">

          <div class="section-header align-center">
               <div class="title">
                    <span>Abstract Factory</span>
               </div>
               <h2 class="section-title">Create Compatible User Loan</h2>
          </div>

          @using (Html.BeginForm("CreateUserLoan", "Admin", FormMethod.Post))
          {
               @Html.AntiForgeryToken()

               <div class="form-group">
                    <label>User Name</label>
                    <input type="text" name="name" class="form-control" required />
               </div>

               <div class="form-group">
                    <label>User Type</label>
                    <select name="userType" class="form-control" required>
                         <option value="Student">Student</option>
                         <option value="Professor">Professor</option>
                    </select>
               </div>

               <div class="form-group">
                    <label>Book Title</label>
                    <input type="text" name="bookTitle" class="form-control" required />
               </div>

               <button type="submit" class="btn borrow-btn">
                    Create Loan
               </button>
          }

          @if (ViewBag.LoanDetails != null)
          {
               <div class="alert alert-success mt-4 text-center">
                    <strong>@ViewBag.UserType:</strong> @ViewBag.UserName <br />
                    @ViewBag.LoanDetails
               </div>
          }

     </div>
</section>
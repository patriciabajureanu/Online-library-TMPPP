@{
     ViewBag.Title = "Template Method";
     Layout = "~/Views/Shared/_Layout.cshtml";
}

<section id="template-method">
     <div class="container">

          <div class="section-header align-center template-header">
               <div class="title">
                    <span>Template Method</span>
               </div>

               <h2 class="section-title">Library Report Generator</h2>

               <p class="template-subtitle">
                    Generate structured PDF or CSV reports using real books, authors and categories from the database.
               </p>
          </div>

          <div class="template-export-card">

               <div class="template-export-header">
                    <span>Database Reports</span>
                    <h3>Choose Export Format</h3>
                    <p>Select the format you want and generate a report based on real library data.</p>
               </div>

               <div class="template-actions">
                    <a href="@Url.Action("TemplateMethod", "Home", new { type = "pdf" })"
                       class="template-btn">
                         Generate PDF Report
                    </a>

                    <a href="@Url.Action("TemplateMethod", "Home", new { type = "csv" })"
                       class="template-btn">
                         Generate CSV Report
                    </a>
               </div>

               @if (ViewBag.FilePath != null)
               {
                    <div class="template-success">
                         <strong>@ViewBag.Type Report</strong> generated successfully from database.
                    </div>

                    <div class="template-download-wrap">
                         <a href="@ViewBag.FilePath"
                            class="template-download-btn"
                            download>
                              Download Report
                         </a>
                    </div>
               }

          </div>

     </div>
</section>
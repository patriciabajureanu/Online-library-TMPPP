<!DOCTYPE html>
<html>
<head>
     <meta charset="utf-8" />
     <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <title>@ViewBag.Title - Online Library</title>
     <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body>
     <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
          <div class="container">
               <a class="navbar-brand" href="@Url.Action("Index", "Book")">Online Library</a>
               <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                       aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
               </button>

               <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                         <li class="nav-item">
                              <a class="nav-link" href="@Url.Action("Index", "Book")">Books</a>
                         </li>
                         <li class="nav-item">
                              <a class="nav-link" href="@Url.Action("Index", "User")">Users</a>
                         </li>
                    </ul>
               </div>
          </div>
     </nav>

     <div class="container mt-4">
          @RenderBody()
     </div>

     <footer class="bg-light text-center text-muted mt-5 p-3">
          &copy; @DateTime.Now.Year - Online Library
     </footer>

     <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
     @RenderSection("scripts", required: false)
</body>
</html>
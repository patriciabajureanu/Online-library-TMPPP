
<!DOCTYPE html>
<html lang="en">
<head>
     <title>@ViewBag.Title - Online Library</title>
     <meta charset="utf-8" />
     <meta name="viewport" content="width=device-width, initial-scale=1.0" />
     <meta http-equiv="X-UA-Compatible" content="IE=edge">
     <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <meta name="format-detection" content="telephone=no">
     <meta name="apple-mobile-web-app-capable" content="yes">
     <meta name="author" content="">
     <meta name="keywords" content="">
     <meta name="description" content="">
     <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css">

     <link rel="stylesheet" href="@Url.Content("~/Content/normalize.css")">
     <link rel="stylesheet" href="@Url.Content("~/Content/icomoon.css")">
     <link rel="stylesheet" href="@Url.Content("~/Content/vendor.css")">
     <link rel="stylesheet" href="@Url.Content("~/Content/style.css")">
</head>
<body data-bs-spy="scroll" data-bs-target="#header" tabindex="0">

     <div id="header-wrap">
          <header id="header" class="modern-header">
               <div class="container">
                    <div class="header-inner">

                         <div class="main-logo">
                              <a href="@Url.Action("Index", "Home")">
                                   <img src="@Url.Content("~/Content/Images/main-logo.png")" alt="Online Library">
                              </a>
                         </div>

                         <nav id="navbar">
                              <ul class="menu-list">

                                   <li class="menu-item">
                                        <a href="@Url.Action("Index", "Home")">Home</a>
                                   </li>

                                   <li class="menu-item">
                                        <a href="@Url.Action("Mediator", "Home")">Search</a>
                                   </li>

                                   <li class="menu-item">
                                        <a href="@Url.Action("Borrow", "Home")">Borrow</a>
                                   </li>

                                   <li class="menu-item">
                                        <a href="@Url.Action("MyLoans", "Home")">My Loans</a>
                                   </li>

                                   <li class="menu-item">
                                        <a href="@Url.Action("MyReservations", "Home")">Reservations</a>
                                   </li>

                                   @if (User.Identity.IsAuthenticated && User.Identity.Name == "patricia.bajureanu@gmail.com")
                                   {
                                        <li class="menu-item">
                                             <a href="@Url.Action("CreateBook", "Admin")">Admin</a>
                                        </li>
                                   }

                                   @if (User.Identity.IsAuthenticated)
                                   {
                                        <li class="menu-item">
                                             <a href="@Url.Action("Logout", "Account")" class="nav-auth-btn">Logout</a>
                                        </li>
                                   }
                                   else
                                   {
                                        <li class="menu-item">
                                             <a href="@Url.Action("Login", "Account")" class="nav-auth-btn">Login</a>
                                        </li>
                                   }

                              </ul>
                         </nav>

                    </div>
               </div>
          </header>
     </div>

     @RenderBody()

     <footer id="footer-bottom" class="modern-footer">
          <div class="container">
               <div class="footer-inner">

                    <p>© 2026 Online Library. All rights reserved.</p>

                    <div class="footer-links">
                         <a href="@Url.Action("Index", "Home")">Home</a>
                         <a href="@Url.Action("Mediator", "Home")">Search</a>
                         <a href="@Url.Action("Borrow", "Home")">Borrow</a>
                    </div>

               </div>
          </div>
     </footer>
     <script src="@Url.Content("~/Scripts/jquery-1.11.0.min.js")"></script>
     <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
     <script src="@Url.Content("~/Scripts/plugins.js")"></script>
     <script src="@Url.Content("~/Scripts/script.js")"></script>
     <script>
          function closeAlert() {
               document.getElementById("observer-alert").style.display = "none";
          }
     </script>
     <script>
          function closeToast() {
               var el = document.getElementById("success-alert");
               if (el) el.style.display = "none";
          }

          // auto-hide după 4 secunde
          setTimeout(function () {
               closeToast();
          }, 4000);
     </script>
     @RenderSection("Scripts", required: false)
</body>
</html>

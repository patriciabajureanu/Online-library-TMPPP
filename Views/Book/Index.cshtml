@model List<OnlineLibrary.FactoryMethod.ILibraryItem>

<h2>Library Books</h2>

<table class="table">
     <thead>
          <tr>
               <th>Title</th>
               <th>Description</th>
               <th>Type</th>
          </tr>
     </thead>
     <tbody>
          @foreach (var book in Model)
          {
               <tr>
                    <td>@book.Title</td>
                    <td>@book.Description</td>
                    <td>@book.BookType</td>
               </tr>
          }
     </tbody>
</table>
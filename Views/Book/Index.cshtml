@model List<OnlineLibrary.Interfaces.ILibraryItem>

<h2>Library Books</h2>

<table class="table">
     <thead>
          <tr>
               <th>Title</th>
               <th>Description</th>
          </tr>
     </thead>
     <tbody>
          @foreach (var book in Model)
          {
               <tr>
                    <td>@book.GetTitle()</td>
                    <td>@book.GetDescription()</td>
               </tr>
          }
     </tbody>
</table>
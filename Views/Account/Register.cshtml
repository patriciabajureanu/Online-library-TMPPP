@model OnlineLibrary.Models.RegisterViewModel

@{
     ViewBag.Title = "Register";
     Layout = "~/Views/Shared/_Layout.cshtml";
}

<section id="register-section" class="py-5 my-5 leaf-pattern-overlay">
     <div class="corner-pattern-overlay"></div>

     <div class="container">
          <div class="row justify-content-center">
               <div class="col-md-6">

                    <div class="section-header align-center mb-3" style="margin-top: -30px;">
                         <div class="title">
                              <span class="welcome-text">Join us</span>
                         </div>
                         <h2 class="section-title">Create Account</h2>
                    </div>

                    <div class="product-entry p-3 bg-white border rounded login-box">

                         @using (Html.BeginForm("Register", "Account", FormMethod.Post))
                         {
                              @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                              <div class="mb-4">
                                   @Html.LabelFor(m => m.Username, new { @class = "mb-2" })
                                   @Html.TextBoxFor(m => m.Username, new
                                   {
                                        @class = "form-control",
                                        placeholder = "Enter username"
                                   })
                                   @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
                              </div>

                              <div class="mb-4">
                                   @Html.LabelFor(m => m.Email, new { @class = "mb-2" })
                                   @Html.TextBoxFor(m => m.Email, new
                                   {
                                        @class = "form-control",
                                        placeholder = "Enter email"
                                   })
                                   @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                              </div>

                              <div class="mb-4">
                                   @Html.LabelFor(m => m.Password, new { @class = "mb-2" })
                                   @Html.PasswordFor(m => m.Password, new
                                   {
                                        @class = "form-control",
                                        placeholder = "Enter password"
                                   })
                                   @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                              </div>

                              <div class="btn-wrap align-center">
                                   <button type="submit" class="btn btn-outline-accent btn-accent-arrow">
                                        Register <i class="icon icon-ns-arrow-right"></i>
                                   </button>
                              </div>

                              <div class="text-center mt-3 register-link">
                                   <span>Already have an account?</span>
                                   @Html.ActionLink("Login", "Login", "Account", null, new { @class = "register-btn" })
                              </div>
                         }

                    </div>

               </div>
          </div>
     </div>
</section>
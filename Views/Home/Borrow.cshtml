<section id="borrow-books" class="borrow-library-section">
     <div class="container">

          <div class="section-header align-center borrow-header">
               <div class="title">
                    <span>Choose a book from our library</span>
               </div>
               <h2 class="section-title">Borrow a Book</h2>
          </div>

          <div class="borrow-overview">
               <div>
                    <span>Total Books</span>
                    <strong>@ViewBag.TotalBooks</strong>
               </div>

               <div>
                    <span>Shared Formats</span>
                    <strong>@ViewBag.TotalSharedFormats</strong>
               </div>
          </div>

          <div class="row">
               @foreach (var book in Model)
               {
                    <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                         <div class="borrow-book-card">

                              <div class="borrow-image-wrap">
                                   <img src="@(string.IsNullOrEmpty(book.CoverImageUrl) ? Url.Content("~/Content/Images/default.png") : book.CoverImageUrl)"
                                        alt="@book.Title"
                                        class="borrow-book-image">
                              </div>

                              <div class="borrow-book-info">
                                   <h3>@book.Title</h3>
                                   <div class="borrow-author">
                                        @(book.Author != null ? book.Author.FullName : "Unknown Author")
                                   </div>
                                   <div class="borrow-meta">
                                        <span>@book.BookType</span>
                                        <span>@book.FormatType</span>
                                        <span>@book.Language</span>
                                        <span>@book.PublishedYear</span>
                                   </div>

                                   <div class="borrow-availability @(book.AvailableCopies > 0 ? "available" : "unavailable")">
                                        <strong>@book.AvailableCopies</strong> / @book.TotalCopies copies available
                                   </div>

                                   @if (book.AvailableCopies > 0)
                                   {
                                        <a href="@Url.Action("BorrowBook", "Home", new { id = book.Id })"
                                           class="borrow-card-btn">
                                             Borrow Book
                                        </a>
                                   }
                                   else
                                   {
                                        <button class="borrow-card-btn borrow-card-btn-disabled" disabled>
                                             Not Available
                                        </button>
                                   }
                              </div>

                         </div>
                    </div>
               }
          </div>

     </div>
</section>
@model IEnumerable<OnlineLibrary.Models.Book>

@{
    ViewBag.Title = "Borrow";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section id="borrow-books" class="bookshelf py-5 my-5">
    <div class="container">
        <div class="row">
            <div class="col-md-12">

                <div class="section-header align-center">
                    <div class="title">
                        <span>Choose a book from our library</span>
                    </div>
                    <h2 class="section-title">Borrow a Book</h2>
                </div>

                <div class="product-list" data-aos="fade-up">
                    <div class="row">

                        @foreach (var book in Model)
                        {
                            <div class="col-md-3 mb-4">
                                <div class="product-item borrow-book-card">

                                    <figure class="product-style">
                                        <img src="@(string.IsNullOrEmpty(book.CoverImageUrl) ? Url.Content("~/Content/Images/default.png") : book.CoverImageUrl)"
                                             alt="@book.Title"
                                             class="product-item borrow-book-image">

                                        @if (book.AvailableCopies > 0)
{
    <a href="@Url.Action("BorrowBook", "Home", new { id = book.Id })"
   class="borrow-card-btn">
    Borrow Book
</a>
}
else
{
    <button class="borrow-card-btn borrow-card-btn-disabled" disabled>
    Not Available
</button>
}

                                    </figure>

                                    <figcaption>
                                        <h3>@book.Title</h3>
                                         <div><strong>Type:</strong> @book.BookType</div>
                                        <div>
                                            <strong>Available:</strong> @book.AvailableCopies / @book.TotalCopies
                                        </div>

                                        <div>
                                            <strong>Status:</strong>
                                            @if (book.AvailableCopies > 0)
                                            {
                                                <span class="text-success">Available</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger">Unavailable</span>
                                            }
                                        </div>
                                    </figcaption>

                                </div>
                            </div>
                        }

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
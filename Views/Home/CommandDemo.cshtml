@{
     ViewBag.Title = "Command Demo";
     Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5">
     <div class="container">
          <h2>Command Pattern Demo</h2>

          <div class="p-4 border rounded">
               <p><strong>Borrow command:</strong> @ViewBag.BorrowResult</p>
               <p><strong>Reserve command after Undo:</strong> @ViewBag.ReserveResult</p>
          </div>
     </div>
</section>
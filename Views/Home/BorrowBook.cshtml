@model OnlineLibrary.Models.Book

@{
     ViewBag.Title = "Borrow Book";
     Layout = "~/Views/Shared/_Layout.cshtml";
}

<section id="borrow-book-details">
     <div class="container">

          <div class="section-header align-center borrow-details-header">
               <div class="title">
                    <span>Confirm your loan</span>
               </div>
               <h2 class="section-title">Borrow Book</h2>
          </div>

          @if (TempData["Error"] != null)
          {
               <div class="borrow-alert">
                    @TempData["Error"]
               </div>
          }

          <div class="borrow-details-card">

               <div class="borrow-details-image-wrap">
                    <img src="@(string.IsNullOrEmpty(Model.CoverImageUrl) ? Url.Content("~/Content/Images/default.png") : Model.CoverImageUrl)"
                         alt="@Model.Title"
                         class="borrow-details-image" />
               </div>

               <div class="borrow-details-content">

                    <span class="borrow-status @(Model.AvailableCopies > 0 ? "available" : "unavailable")">
                         @(Model.AvailableCopies > 0 ? "Available to borrow" : "Currently unavailable")
                    </span>

                    <h3>@Model.Title</h3>

                    <p class="borrow-description">
                         @Model.Description
                    </p>

                    <div class="borrow-details-grid">

                         <div>
                              <span>ISBN</span>
                              <strong>@Model.ISBN</strong>
                         </div>

                         <div>
                              <span>Language</span>
                              <strong>@Model.Language</strong>
                         </div>

                         <div>
                              <span>Published</span>
                              <strong>@Model.PublishedYear</strong>
                         </div>

                         <div>
                              <span>Pages</span>
                              <strong>@Model.Pages</strong>
                         </div>

                         <div>
                              <span>Book Type</span>
                              <strong>@Model.BookType</strong>
                         </div>

                         <div>
                              <span>Format</span>
                              <strong>@Model.FormatType</strong>
                         </div>

                         <div>
                              <span>Available Copies</span>
                              <strong>@Model.AvailableCopies / @Model.TotalCopies</strong>
                         </div>

                         <div>
                              <span>Created At</span>
                              <strong>
                                   @(Model.CreatedAt.HasValue
     ? Model.CreatedAt.Value.ToString("dd MMM yyyy")
     : "Unknown")
                              </strong>
                         </div>

                    </div>

                    <div class="borrow-actions">
                         @if (Model.AvailableCopies > 0)
                         {
                              using (Html.BeginForm("BorrowBookConfirm", "Home", FormMethod.Post))
                              {
                                   @Html.AntiForgeryToken()
                                   @Html.HiddenFor(m => m.Id)

                                   <button type="submit" class="borrow-action-btn primary-btn">
                                        <span>Borrow Book</span>
                                        <i class="icon icon-ns-arrow-right"></i>
                                   </button>
                              }
                         }
                         else
                         {
                              <button class="borrow-action-btn disabled-btn" disabled>
                                   Not Available
                              </button>
                         }

                         @using (Html.BeginForm("ReserveBook", "Home", FormMethod.Post))
                         {
                              @Html.AntiForgeryToken()
                              @Html.HiddenFor(m => m.Id)

                              <button type="submit" class="borrow-action-btn reserve-btn">
                                   <span>Reserve Book</span>
                                   <i class="icon icon-ns-arrow-right"></i>
                              </button>
                         }

                         <a href="@Url.Action("Borrow", "Home")" class="borrow-action-btn back-btn">
                              <span>Back</span>
                         </a>
                    </div>

               </div>

          </div>

     </div>
</section>
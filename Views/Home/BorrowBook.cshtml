@model OnlineLibrary.Models.Book

@{
     ViewBag.Title = "Borrow Book";
     Layout = "~/Views/Shared/_Layout.cshtml";
}

<section id="borrow-book-details" class="py-5 my-5">
     <div class="container">

          <div class="section-header align-center">
               <div class="title">
                    <span>Confirm your loan</span>
               </div>
               <h2 class="section-title">Borrow Book</h2>
          </div>

          @if (TempData["Error"] != null)
          {
               <div class="alert alert-danger text-center">
                    @TempData["Error"]
               </div>
          }

          <div class="row justify-content-center">
               <div class="col-md-8">
                    <div class="borrow-details-card">

                         <div class="row">
                              <div class="col-md-5">
                                   <img src="@(string.IsNullOrEmpty(Model.CoverImageUrl) ? Url.Content("~/Content/Images/default.png") : Model.CoverImageUrl)"
                                        alt="@Model.Title"
                                        class="borrow-details-image" />
                              </div>

                              <div class="col-md-7">
                                   <h3>@Model.Title</h3>

                                   <p>@Model.Description</p>

                                   <div><strong>ISBN:</strong> @Model.ISBN</div>
                                   <div><strong>Language:</strong> @Model.Language</div>
                                   <div><strong>Published Year:</strong> @Model.PublishedYear</div>
                                   <div><strong>Available Copies:</strong> @Model.AvailableCopies</div>
                                   <div class="mt-4">
                                        @if (Model.AvailableCopies > 0)
                                        {
                                             using (Html.BeginForm("ConfirmBorrowBook", "Home", FormMethod.Post))
                                             {
                                                  @Html.AntiForgeryToken()
                                                  @Html.HiddenFor(m => m.Id)

                                              

                                                  <button type="submit" class="btn borrow-btn">
                                                       <span>Confirm Borrow</span>
                                                       <i class="icon icon-ns-arrow-right"></i>
                                                  </button>
                                             }
                                        }
                                        else
                                        {
                                             <button class="btn btn-secondary" disabled>
                                                  Not Available
                                             </button>
                                        }

                                        <a href="@Url.Action("Borrow", "Home")" class="btn borrow-btn back-btn">
                                             <span>Back</span>
                                        </a>
                                   </div>

                              </div>
                         </div>

                    </div>
               </div>
          </div>

     </div>
</section>
@model List<OnlineLibrary.Models.Book>

@{
     ViewBag.Title = "Books";
}

<h2>Books from Database</h2>

<table class="table">
     <thead>
          <tr>
               <th>Title</th>
               <th>Description</th>
               <th>Total Copies</th>
               <th>Available Copies</th>
          </tr>
     </thead>
     <tbody>
          @foreach (var book in Model)
          {
               <tr>
                    <td>
                         <a href="/Home/Details/@book.Id">
                              @book.Title
                         </a>
                    </td>
                    <td>@book.Description</td>
                    <td>@book.TotalCopies</td>
                    <td>@book.AvailableCopies</td>
               </tr>
          }
     </tbody>
</table>
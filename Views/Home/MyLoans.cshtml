@model IEnumerable<OnlineLibrary.Models.Loan>

@{
     ViewBag.Title = "My Loans";
     Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (TempData["BridgeMessage"] != null)
{
     <div class="bridge-message text-center mb-4">
          @TempData["BridgeMessage"]
     </div>
}

@if (TempData["Success"] != null)
{
     <div id="success-alert" class="custom-toast">
          <span>@TempData["Success"]</span>
          <button onclick="closeToast()">×</button>
     </div>
}

<section id="my-loans" class="bookshelf py-5 my-5">
     <div class="container">

          <div class="section-header align-center">
               <div class="title">
                    <span>Your borrowed books</span>
               </div>
               <h2 class="section-title">My Loans</h2>
          </div>

          @if (!Model.Any())
          {
               <div class="text-center">
                    <p>You have no borrowed books yet.</p>

                    <a href="@Url.Action("Borrow", "Home")" class="btn borrow-btn">
                         Borrow a Book
                    </a>
               </div>
          }
          else
          {
               
                    var activeLoans = Model.Where(x => !x.IsReturned).ToList();
                    var returnedLoans = Model.Where(x => x.IsReturned).ToList();
              

               if (activeLoans.Any())
               {
                    <div class="loan-group">

                         <div class="loan-group-header">
                              <h3>Active Loans</h3>
                              <span>@activeLoans.Count books</span>
                         </div>

                         <div class="row">

                              @foreach (var loan in activeLoans)
                              {
                                   <div class="col-lg-6 mb-4">

                                        <div class="loan-list-card active-card">

                                             <div class="loan-cover">
                                                  <img src="@(loan.Book == null || string.IsNullOrEmpty(loan.Book.CoverImageUrl)
                                        ? Url.Content("~/Content/Images/default.png")
                                        : loan.Book.CoverImageUrl)"
                                                       alt="Book"
                                                       class="loan-cover-image">
                                             </div>

                                             <div class="loan-info">

                                                  <h4>
                                                       @(loan.Book == null ? "Unknown Book" : loan.Book.Title)
                                                  </h4>

                                                  @if (loan.Book != null && loan.Book.Author != null)
                                                  {
                                                       <div class="loan-author">
                                                            @loan.Book.Author.FullName
                                                       </div>
                                                  }

                                                  <div class="loan-meta">

                                                       <div>
                                                            <span>Borrowed</span>
                                                            <strong>@loan.BorrowDate.ToString("dd MMM yyyy")</strong>
                                                       </div>

                                                       @if (loan.DueDate.HasValue)
                                                       {
                                                            <div>
                                                                 <span>Due Date</span>
                                                                 <strong>@loan.DueDate.Value.ToString("dd MMM yyyy")</strong>
                                                            </div>
                                                       }

                                                       <div>
                                                            <span>Status</span>

                                                            @if (loan.DueDate.HasValue && loan.DueDate.Value < DateTime.Now)
                                                            {
                                                                 <strong class="loan-status overdue">
                                                                      OVERDUE
                                                                 </strong>
                                                            }
                                                            else
                                                            {
                                                                 <strong class="loan-status active">
                                                                      ACTIVE
                                                                 </strong>
                                                            }
                                                       </div>

                                                  </div>

                                                  @{
                                                       var resourceType =
                                                            string.IsNullOrEmpty(loan.Book?.BookType)
                                                            ? "ebook"
                                                            : loan.Book.BookType.ToLower();
                                                  }

                                             <div class="loan-actions">

                                                  <a href="@Url.Action("Read", "Home", new { id = loan.Book.Id })"
                                                     class="mini-loan-btn filled-btn">
                                                       Read
                                                  </a>

                                                  <div class="loan-resource-dropdown">
                                                       <button type="button" class="mini-loan-btn resource-toggle">
                                                            Resources
                                                       </button>

                                                       <div class="resource-menu">
                                                            <a href="@Url.Action("AccessLoanResource", "Home", new {
                    resourceType = resourceType,
                    deliveryType = "download",
                    id = loan.Book.Id
               })">
                                                                 Download
                                                            </a>

                                                            <a href="@Url.Action("AccessLoanResource", "Home", new {
                    resourceType = resourceType,
                    deliveryType = "streaming",
                    id = loan.Book.Id
               })">
                                                                 Stream
                                                            </a>

                                                            <a href="@Url.Action("AccessLoanResource", "Home", new {
                    resourceType = resourceType,
                    deliveryType = "cloud",
                    id = loan.Book.Id
               })">
                                                                 Cloud
                                                            </a>
                                                       </div>
                                                  </div>

                                                  @using (Html.BeginForm("ReturnBook", "Home", FormMethod.Post))
                                                  {
                                                       @Html.AntiForgeryToken()
                                                       <input type="hidden" name="id" value="@loan.Id" />

                                                       <button type="submit" class="mini-loan-btn danger-btn">
                                                            Return
                                                       </button>
                                                  }

                                             </div>

                                             </div>

                                        </div>

                                   </div>
                              }

                         </div>

                    </div>
               }

               if (returnedLoans.Any())
               {
                    <div class="loan-group mt-5">

                         <div class="loan-group-header">
                              <h3>Returned Books</h3>
                              <span>@returnedLoans.Count books</span>
                         </div>

                         <div class="row">

                              @foreach (var loan in returnedLoans)
                              {
                                   <div class="col-lg-6 mb-4">

                                        <div class="loan-list-card returned-card">

                                             <div class="loan-cover">
                                                  <img src="@(loan.Book == null || string.IsNullOrEmpty(loan.Book.CoverImageUrl)
                                        ? Url.Content("~/Content/Images/default.png")
                                        : loan.Book.CoverImageUrl)"
                                                       alt="Book"
                                                       class="loan-cover-image">
                                             </div>

                                             <div class="loan-info">

                                                  <h4>
                                                       @(loan.Book == null ? "Unknown Book" : loan.Book.Title)
                                                  </h4>

                                                  <div class="loan-meta">

                                                       <div>
                                                            <span>Borrowed</span>
                                                            <strong>@loan.BorrowDate.ToString("dd MMM yyyy")</strong>
                                                       </div>

                                                       @if (loan.ReturnDate.HasValue)
                                                       {
                                                            <div>
                                                                 <span>Returned</span>
                                                                 <strong>@loan.ReturnDate.Value.ToString("dd MMM yyyy")</strong>
                                                            </div>
                                                       }

                                                       <div>
                                                            <span>Status</span>
                                                            <strong class="loan-status returned">
                                                                 RETURNED
                                                            </strong>
                                                       </div>

                                                  </div>

                                             </div>

                                        </div>

                                   </div>
                              }

                         </div>

                    </div>
               }
          }

     </div>
</section>
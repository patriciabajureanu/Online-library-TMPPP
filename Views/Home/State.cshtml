@model IEnumerable<OnlineLibrary.Models.MembershipStateViewModel>

<section id="membership-state-page">
     <div class="container">

          <div class="section-header align-center">
               <div class="title">
                    <span>Admin Overview</span>
               </div>

               <h2 class="section-title">Membership State</h2>
          </div>

          <div class="membership-table-wrap">

               <table class="membership-table">

                    <thead>
                         <tr>
                              <th>User</th>
                              <th>Email</th>
                              <th>Role</th>
                              <th>Active Loans</th>
                              <th>Status</th>
                         </tr>
                    </thead>

                    <tbody>

                         @foreach (var user in Model)
                         {
                              <tr>
                                   <td>@user.Username</td>
                                   <td>@user.Email</td>
                                   <td>@user.Role</td>
                                   <td>@user.ActiveLoans</td>

                                   <td>
                                        <span class="membership-badge
                                             @(user.MembershipState == "Active" ? "active" :
                                               user.MembershipState == "Limit Reached" ? "limit" :
                                               "inactive")">

                                             @user.MembershipState
                                        </span>
                                   </td>
                              </tr>
                         }

                    </tbody>

               </table>

          </div>

     </div>
</section>
@model OnlineLibrary.Models.ProxyDemoViewModel

@{
     ViewBag.Title = "Proxy Demo";
     Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5">
     <div class="container">
          <div class="section-header align-center">
               <div class="title">
                    <span>Design Pattern Demonstration</span>
               </div>
               <h2 class="section-title">Proxy Pattern</h2>
          </div>

          <div class="mb-4">
               <p>
                    The Proxy Pattern controls access to the real service and can add
                    extra functionality such as authorization and caching.
               </p>
          </div>

          <div class="row">
               <div class="col-md-8 offset-md-2">
                    <div class="p-4 border rounded bg-white">
                         <p><strong>Document ID:</strong> @Model.DocumentId</p>
                         <p><strong>User Membership:</strong> @(Model.HasMembership ? "Da" : "Nu")</p>
                         <hr />
                         <p><strong>Metadata:</strong> @Model.MetadataResult</p>
                         <p><strong>Prima încărcare document:</strong> @Model.DocumentResult</p>
                         <p><strong>A doua încărcare document:</strong> @Model.CachedDocumentResult</p>
                    </div>
               </div>
          </div>
     </div>
</section>
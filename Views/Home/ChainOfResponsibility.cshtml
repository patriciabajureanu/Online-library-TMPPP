@using OnlineLibrary.ChainOfResponsibility
@{
    ViewBag.Title = "Chain of Responsibility";
    var result = ViewBag.Result as AccessResult;
    var book = ViewBag.Book;
}

<div class="container mt-5">
    <h2 class="mb-4">Chain of Responsibility - Borrow Access</h2>

    <div class="card shadow-sm p-4">
        <h4>@book.Title</h4>

        @if (result != null && result.Granted)
        {
            <div class="alert alert-success mt-3">
                Access granted: @result.Message
            </div>
        }
        else
        {
            <div class="alert alert-danger mt-3">
                Access denied: @result.Message
            </div>
        }

        <hr />

        <h5>Request validation chain:</h5>

        <ol class="mt-3">
            <li>MembershipHandler - checks if the user is logged in</li>
            <li>AvailabilityHandler - checks if the book has available copies</li>
            <li>BorrowLimitHandler - checks if user has less than 3 active loans</li>
        </ol>
    </div>
</div>
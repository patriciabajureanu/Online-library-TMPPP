@{
     ViewBag.Title = "Visitor Pattern";
     var sizeResults = ViewBag.SizeResults as List<string>;
     var previewResults = ViewBag.PreviewResults as List<string>;
}

<div class="container mt-5">
     <h2 class="mb-4">Visitor Pattern - Library Resources</h2>

     <div class="card shadow-sm p-4 mb-4">
          <h4>Size Calculator Visitor</h4>

          <ul class="list-group mt-3">
               @foreach (var item in sizeResults)
               {
                    <li class="list-group-item">
                         @item
                    </li>
               }
          </ul>
     </div>

     <div class="card shadow-sm p-4">
          <h4>Preview Visitor</h4>

          <ul class="list-group mt-3">
               @foreach (var item in previewResults)
               {
                    <li class="list-group-item">
                         @item
                    </li>
               }
          </ul>
     </div>
</div>
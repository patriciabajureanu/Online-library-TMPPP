@{
     ViewBag.Title = "Visitor Pattern";
     Layout = "~/Views/Shared/_Layout.cshtml";

     var sizeResults = ViewBag.SizeResults as List<string>;
}

<section id="visitor-pattern">
     <div class="container">

          <div class="section-header align-center visitor-header">
               <div class="title">
                    <span>Visitor Pattern</span>
               </div>

               <h2 class="section-title">Library Resource Size Calculator</h2>

               <p class="visitor-subtitle">
                    The Visitor pattern is used to calculate resource sizes without changing the resource classes.
               </p>
          </div>

          <div class="visitor-card visitor-single-card">

               <div class="visitor-card-header">
                    <span>Size Calculator Visitor</span>
                    <h3>Resource Size Results</h3>
                    <p>
                         Each library resource accepts the visitor, and the visitor applies the correct calculation
                         depending on the resource type.
                    </p>
               </div>

               <ul class="visitor-list">
                    @foreach (var item in sizeResults)
                    {
                         <li>@item</li>
                    }
               </ul>

          </div>

     </div>
</section>
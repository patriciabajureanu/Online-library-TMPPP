@using OnlineLibrary.Composite
@{
    ViewBag.Title = "Library by Category";
    var categories = ViewBag.Categories as List<CategoryComponent>;
}

<div class="container mt-5">
    <h2 class="text-center mb-5 fw-light">Library Catalog</h2>

    @if (categories != null && categories.Any())
    {
        foreach (var category in categories)
        {
            <div class="mb-5">

                <!-- Category -->
                <h3 class="mb-4 text-dark border-bottom pb-2">
                    📚 @category.Name
                </h3>

                @foreach (AuthorComponent author in category.GetChildren())
                {
                    <div class="mb-4 ps-3">

                        <!-- Author -->
                        <h5 class="author-title mb-3">
    ✍️ @author.Name
</h5>

                        <!-- Books -->
                        <div class="row">
                            @foreach (BookComponent book in author.GetChildren())
                            {
                                <div class="col-md-4 mb-3">
                                    <div class="p-3 border rounded shadow-sm h-100 book-card">
                                        <h6 class="mb-2 text-dark">
                                            📖 @book.Title
                                        </h6>
                                        <small class="text-muted">
                                            @book.Pages pages
                                        </small>
                                    </div>
                                </div>
                            }
                        </div>

                    </div>
                }

            </div>
        }
    }
    else
    {
        <p class="text-center text-muted">No data available.</p>
    }
</div>
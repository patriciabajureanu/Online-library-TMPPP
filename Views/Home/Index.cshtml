@model OnlineLibrary.Models.HomeViewModel

@{
     ViewBag.Title = "Home";
     Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (TempData["Success"] != null)
{
     <div id="success-toast" class="custom-toast">
          <span>@TempData["Success"]</span>
          <button onclick="closeToast()">×</button>
     </div>
}

@if (TempData["Error"] != null)
{
     <div id="error-toast" class="custom-toast error-toast">
          <span>@TempData["Error"]</span>
          <button onclick="closeToast()">×</button>
     </div>
}

<section id="billboard">

     <div class="container">
          <!-- HEADER -->
          <div class="section-header align-center billboard-header">

               <div class="title">
                    <span>Featured Library Collection</span>
               </div>

               <h2 class="section-title">
                    Discover Popular Books
               </h2>

          </div>
          <div class="row">
               <div class="col-md-12">

                    <button class="prev slick-arrow">
                         <i class="icon icon-arrow-left"></i>
                    </button>

                    <div class="main-slider">
                         @{
                              var slideIndex = 0;
                         }

                         @foreach (var book in Model.FeaturedBooks)
                         {
                              <div class="slider-item @(slideIndex == 0 ? "active-slide" : "")">
                                   <div class="banner-content">
                                        <h2 class="banner-title">@book.Title</h2>

                                        <p>@book.Description</p>

                                        <div class="btn-wrap">
                                             <a href="@Url.Action("Read", "Home", new { id = book.Id })"
                                                class="hero-read-btn">
                                                  Read Book <i class="icon icon-ns-arrow-right"></i>
                                             </a>
                                        </div>
                                   </div>

                                   <img src="@(string.IsNullOrEmpty(book.ImagePath) ? Url.Content("~/Content/Images/default.jpg") : book.ImagePath)"
                                        alt="@book.Title"
                                        class="banner-image">
                              </div>

                              slideIndex++;
                         }

                    </div>

                    <button class="next slick-arrow">
                         <i class="icon icon-arrow-right"></i>
                    </button>

               </div>
          </div>
     </div>
</section>

<section id="newest-books" class="library-showcase">
     <div class="container">

          <div class="section-header align-center newest-header">
               <div class="title">
                    <span>Browse Library</span>
               </div>

               <h2 class="section-title">Explore Our Collection</h2>

               <div class="sort-container">
                    <span class="sort-label">Sort by</span>

                    <div class="sort-buttons">
                         <a href="@Url.Action("Index", "Home", new { sortType = "title" })#newest-books"
                            class="sort-btn @(Request["sortType"] == "title" || Request["sortType"] == null ? "active" : "")">
                              Title
                         </a>

                         <a href="@Url.Action("Index", "Home", new { sortType = "id" })#newest-books"
                            class="sort-btn @(Request["sortType"] == "id" ? "active" : "")">
                              Id
                         </a>

                         <a href="@Url.Action("Index", "Home", new { sortType = "format" })#newest-books"
                            class="sort-btn @(Request["sortType"] == "format" ? "active" : "")">
                              Format
                         </a>
                    </div>
               </div>
          </div>

          <div class="product-list newest-product-list">
               <div class="row">
                    @foreach (var book in Model.FeaturedBooks.Take(8))
                    {
                         <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                              <div class="newest-book-card">

                                   <figure class="product-style">
                                        <img src="@(string.IsNullOrEmpty(book.ImagePath) ? Url.Content("~/Content/Images/default.jpg") : book.ImagePath)"
                                             alt="@book.Title"
                                             class="newest-book-image">
                                   </figure>

                                   <figcaption class="book-info">
                                        <h3>@book.Title</h3>

                                        <div class="book-meta">
                                             <span>@book.BookType</span>
                                             <span>@book.Language</span>
                                             <span>@book.PublishedYear</span>
                                        </div>

                                        <a href="@Url.Action("AccessLoanResource", "Home", new {
                                             resourceType = "ebook",
                                             deliveryType = "download",
                                             id = book.Id
                                        })"
                                           class="download-btn">
                                             Download
                                        </a>
                                   </figcaption>

                              </div>
                         </div>
                    }
               </div>
          </div>

          <div class="text-center mt-4">
               <a href="@Url.Action("Composite", "Home")"
                  class="view-all-btn">
                    View All by Category <i class="icon icon-ns-arrow-right"></i>
               </a>
          </div>

     </div>
</section>


<section id="best-selling" class="best-borrowed-section">
     <div class="container">
          @if (Model.BestBook != null)
          {
               <div class="best-borrowed-card">

                    <div class="best-book-image-wrap">
                         <img src="@(string.IsNullOrEmpty(Model.BestBook.ImagePath) ? Url.Content("~/Content/Images/default.jpg") : Model.BestBook.ImagePath)"
                              alt="@Model.BestBook.Title"
                              class="best-book-image">
                    </div>

                    <div class="best-book-content">
                         <span class="best-book-label">Most Popular</span>

                         <h2>Best Borrowed Book</h2>

                         <h3>@Model.BestBook.Title</h3>

                         <p>
                              @Model.BestBook.Description
                         </p>

                         <div class="best-book-meta">
                              <div>
                                   <span>Author</span>
                                   <strong>@Model.BestBook.AuthorName</strong>                              </div>

                              <div>
                                   <span>Language</span>
                                   <strong>@Model.BestBook.Language</strong>
                              </div>

                              <div>
                                   <span>Published</span>
                                   <strong>@Model.BestBook.PublishedYear</strong>
                              </div>

                              <div>
                                   <span>Available</span>
                                   <strong>@Model.BestBook.AvailableCopies copies</strong>
                              </div>
                         </div>

                         <a href="@Url.Action("Read", "Home", new { id = Model.BestBook.Id })"
                            class="best-read-btn">
                              Read Book <i class="icon icon-ns-arrow-right"></i>
                         </a>
                    </div>

               </div>
          }
     </div>
</section>

<section id="books-available" class="bookshelf py-5 my-5">
     <div class="container">
          <div class="row">
               <div class="col-md-12">

                    <div class="section-header align-center">
                         <div class="title">
                              <span>See which books you can borrow</span>
                         </div>
                         <h2 class="section-title">Check Book Availability</h2>
                    </div>

                    <div class="product-list">
                         <div class="row">

                              @foreach (var book in Model.FeaturedBooks)
                              {
                                   <div class="col-md-3 mb-4">
                                        <div class="product-item">

                                             <figure class="product-style">
                                                  <img src="@(string.IsNullOrEmpty(book.ImagePath) ? Url.Content("~/Content/Images/default.jpg") : book.ImagePath)"
                                                       alt="@book.Title"
                                                       class="product-item newest-book-image">
                                             </figure>

                                             <figcaption>
                                                  <h3>@book.Title</h3>
                                                  <div><strong>Category:</strong> @book.CategoryName</div>
                                                  <div><strong>Language:</strong> @book.Language</div>
                                                  <div><strong>Year:</strong> @book.PublishedYear</div>
                                                  <div class="mt-3 text-center">
                                                       <a href="@Url.Action("ChainOfResponsibility", "Home", new { bookId = book.Id })"
                                                          class="btn btn-sm btn-outline-primary">
                                                            Check Access
                                                       </a>
                                                  </div>
                                             </figcaption>

                                        </div>
                                   </div>
                              }

                         </div>
                    </div>

               </div>
          </div>
     </div>
</section>
<script>
     document.addEventListener("DOMContentLoaded", function () {
          var slides = document.querySelectorAll("#billboard .slider-item");
          var prevBtn = document.querySelector("#billboard .prev");
          var nextBtn = document.querySelector("#billboard .next");
          var current = 0;

          function showSlide(index) {
               slides.forEach(function (slide) {
                    slide.classList.remove("active-slide");
               });

               slides[index].classList.add("active-slide");
          }

          if (slides.length > 0) {
               showSlide(current);
          }

          if (nextBtn) {
               nextBtn.addEventListener("click", function () {
                    current = (current + 1) % slides.length;
                    showSlide(current);
               });
          }

          if (prevBtn) {
               prevBtn.addEventListener("click", function () {
                    current = (current - 1 + slides.length) % slides.length;
                    showSlide(current);
               });
          }
     });
</script>

<script>
     function closeToast() {
          document.getElementById("success-toast")?.remove();
          document.getElementById("error-toast")?.remove();
     }

     setTimeout(function () {
          closeToast();
     }, 4000);
</script>

@{
     ViewBag.Title = "Online Library - Design Patterns";
}

<main class="container mt-4">
     <h1 class="mb-4 text-center">Online Library - Creational Patterns Demo</h1>

     <!-- ========================= -->
     <!-- FACTORY METHOD -->
     <!-- ========================= -->
     <section class="mb-5 border-bottom pb-4">
          <h2 class="text-primary">Factory Method</h2>
          <p class="text-muted">Create different types of books using a factory.</p>

          <form method="post" asp-controller="Book" asp-action="Create">
               <div class="mb-3">
                    <label class="form-label">Book Title:</label>
                    <input type="text" name="title" class="form-control" required />
               </div>

               <div class="mb-3">
                    <label class="form-label">Book Type:</label>
                    <select name="bookType" class="form-select">
                         <option value="Printed">Printed Book</option>
                         <option value="Digital">Digital Book</option>
                         <option value="Audio">Audio Book</option>
                    </select>
               </div>

               <button type="submit" class="btn btn-primary">Create Book</button>
          </form>

          @if (ViewBag.BookDescription != null)
          {
               <div class="alert alert-primary mt-3">
                    @ViewBag.BookDescription
               </div>
          }
     </section>


     <!-- ========================= -->
     <!-- BUILDER -->
     <!-- ========================= -->
     <section class="mb-5 border-bottom pb-4">
          <h2 class="text-warning">Builder Pattern</h2>
          <p class="text-muted">Build complex publications step by step.</p>

          <form method="post" asp-controller="Publication" asp-action="Build">
               <div class="row">
                    <div class="col-md-6 mb-3">
                         <label class="form-label">Title:</label>
                         <input type="text" name="title" class="form-control" required />
                    </div>

                    <div class="col-md-6 mb-3">
                         <label class="form-label">Author / Publisher:</label>
                         <input type="text" name="author" class="form-control" required />
                    </div>
               </div>

               <div class="row">
                    <div class="col-md-6 mb-3">
                         <label class="form-label">Type:</label>
                         <select name="type" class="form-select">
                              <option value="Book">Book</option>
                              <option value="Magazine">Magazine</option>
                         </select>
                    </div>

                    <div class="col-md-6 mb-3">
                         <label class="form-label">Pages / Issue Number:</label>
                         <input type="number" name="detail" class="form-control" required />
                    </div>
               </div>

               <button type="submit" class="btn btn-warning">Build Publication</button>
          </form>

          @if (ViewBag.BuilderResult != null)
          {
               <div class="alert alert-warning mt-3">
                    @ViewBag.BuilderResult
               </div>
          }
     </section>


     <!-- ========================= -->
     <!-- ABSTRACT FACTORY -->
     <!-- ========================= -->
     <section class="mb-5">
          <h2 class="text-success">Abstract Factory</h2>
          <p class="text-muted">Create a User together with its Loan using a factory family.</p>

          <form method="post" asp-controller="User" asp-action="Create">
               <div class="mb-3">
                    <label class="form-label">User Name:</label>
                    <input type="text" name="userName" class="form-control" required />
               </div>

               <div class="mb-3">
                    <label class="form-label">User Type:</label>
                    <select name="userType" class="form-select">
                         <option value="Student">Student</option>
                         <option value="Professor">Professor</option>
                    </select>
               </div>

               <div class="mb-3">
                    <label class="form-label">Book Title for Loan:</label>
                    <input type="text" name="bookLoan" class="form-control" required />
               </div>

               <button type="submit" class="btn btn-success">Create User + Loan</button>
          </form>

          @if (ViewBag.UserLoan != null)
          {
               <div class="alert alert-success mt-3">
                    @ViewBag.UserLoan
               </div>
          }
     </section>
     <!-- ========================= -->
     <!-- PROTOTYPE -->
     <!-- ========================= -->
     <section class="mb-5 border-bottom pb-4">
          <h2 class="text-info">Prototype Pattern</h2>
          <p class="text-muted">Clone a membership template (Student or Professor).</p>

          <form method="post" asp-controller="Membership" asp-action="Clone">
               <div class="mb-3">
                    <label class="form-label">Select Base Prototype:</label>
                    <div class="btn-group w-100" role="group">
                         <input type="radio" class="btn-check" name="prototypeKey" id="proto1" value="Student" checked>
                         <label class="btn btn-outline-info" for="proto1">Student Template</label>

                         <input type="radio" class="btn-check" name="prototypeKey" id="proto2" value="Professor">
                         <label class="btn btn-outline-info" for="proto2">Professor Template</label>
                    </div>
               </div>

               <div class="mb-3">
                    <label for="customLimit" class="form-label">Adjust Max Books (Optional):</label>
                    <input type="number" id="customLimit" name="customLimit" class="form-control" placeholder="Leave empty to keep default" />
               </div>

               <button type="submit" class="btn btn-info text-white">Clone Membership</button>
          </form>

          @if (ViewBag.PrototypeResult != null)
          {
               <div class="alert alert-info mt-3">
                    <strong>Cloned Membership:</strong> @ViewBag.PrototypeResult
               </div>
          }
     </section>
     <!-- ========================= -->
     <!-- SINGLETON -->
     <!-- ========================= -->
     <section class="mb-5 border-bottom pb-4">
          <h2 class="text-dark">Singleton Pattern</h2>
          <p class="text-muted">Access a single instance of DatabaseManager.</p>

          <form method="post" asp-controller="Singleton" asp-action="Index">
               <button type="submit" class="btn btn-dark">Test Singleton</button>
          </form>

          @if (ViewBag.SingletonDemo != null)
          {
               <div class="alert alert-dark mt-3">
                    @ViewBag.SingletonDemo
               </div>
          }
     </section>
     <!-- ========================= -->
     <!-- PROTOTYPE -->
     <!-- ========================= -->
     <section class="mb-5 border-bottom pb-4">
          <h2 class="text-info">Prototype Pattern</h2>
          <p class="text-muted">Clone a report template using the Prototype pattern.</p>

          <form method="post" asp-controller="Report" asp-action="Clone">

               <div class="mb-3">
                    <label class="form-label">Select Report Prototype:</label>

                    <div class="btn-group w-100" role="group">

                         <input type="radio" class="btn-check"
                                name="prototypeKey"
                                id="proto1"
                                value="BasicReport"
                                checked>

                         <label class="btn btn-outline-info" for="proto1">
                              Basic Report Template
                         </label>

                         <input type="radio" class="btn-check"
                                name="prototypeKey"
                                id="proto2"
                                value="AnalyticalReport">

                         <label class="btn btn-outline-info" for="proto2">
                              Analytical Report Template
                         </label>

                    </div>
               </div>


               <div class="mb-3">
                    <label class="form-label">Custom Title (Optional):</label>
                    <input type="text"
                           name="customTitle"
                           class="form-control"
                           placeholder="Leave empty to keep default title" />
               </div>


               <button type="submit" class="btn btn-info text-white">
                    Clone Report
               </button>

          </form>


          @if (ViewBag.PrototypeResult != null)
          {
               <div class="alert alert-info mt-3">
                    <strong>Cloned Report:</strong>
                    @ViewBag.PrototypeResult
               </div>
          }

     </section>
     <!-- ========================= -->
     <!-- ADAPTER PATTERN - PDF Reader -->
     <!-- ========================= -->
     <section class="mb-5 border-bottom pb-4">
          <h2 class="text-info">Adapter Pattern - PDF Reader</h2>
          <p class="text-muted">Open and navigate PDF books using the Adapter pattern.</p>

          <form method="get" asp-controller="Reader" asp-action="Read">
               <div class="mb-3">
                    <label class="form-label">Select PDF File:</label>
                    <input type="text"
                           name="filePath"
                           class="form-control"
                           placeholder="Enter PDF file name (e.g., book.pdf)"
                           required />
               </div>
               <button type="submit" class="btn btn-info text-white">Open Book</button>
          </form>

          <form method="get" asp-controller="Reader" asp-action="GoToPage" class="mt-3">
               <div class="mb-3">
                    <label class="form-label">Go To Page:</label>
                    <input type="number"
                           name="page"
                           class="form-control"
                           placeholder="Enter page number"
                           required />
               </div>
               <button type="submit" class="btn btn-info text-white">Go To Page</button>
          </form>

          <form method="get" asp-controller="Reader" asp-action="Close" class="mt-3">
               <button type="submit" class="btn btn-danger text-white">Close Book</button>
          </form>

          @if (ViewBag.AdapterResult != null)
          {
               <div class="alert alert-info mt-3">
                    <strong>Result:</strong> @ViewBag.AdapterResult
               </div>
          }
     </section>
     @{
          ViewBag.Title = "Library Composite Example";
     }

     <h2>@ViewBag.Title</h2>

<pre>
@Html.Raw(ViewBag.LibraryDisplay)
</pre>

     <p>Total cărți în librărie: <strong>@ViewBag.TotalBooks</strong></p>
     <p>Total cărți Science Fiction: <strong>@ViewBag.SciFiTotal</strong></p>
     <p>Total cărți Fantasy: <strong>@ViewBag.FantasyTotal</strong></p>

     @{
          ViewBag.Title = "Online Library";
     }

     <h2>Borrow Book</h2>
     <p>@ViewBag.Result</p>
</main>
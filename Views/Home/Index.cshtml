@model OnlineLibrary.Models.HomeViewModel

@{
     ViewBag.Title = "Home";
     Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (TempData["Success"] != null)
{
     <div id="success-toast" class="custom-toast">
          <span>@TempData["Success"]</span>
          <button onclick="closeToast()">×</button>
     </div>
}

@if (TempData["Error"] != null)
{
     <div id="error-toast" class="custom-toast error-toast">
          <span>@TempData["Error"]</span>
          <button onclick="closeToast()">×</button>
     </div>
}

<section id="billboard">

     <div class="container">
          <div class="row">
               <div class="col-md-12">

                    <button class="prev slick-arrow">
                         <i class="icon icon-arrow-left"></i>
                    </button>

                    <div class="main-slider pattern-overlay">

                         @foreach (var book in Model.FeaturedBooks)
                         {
                              <div class="slider-item">
                                   <div class="banner-content">
                                        <h2 class="banner-title">@book.Title</h2>

                                        <p>
                                             @book.Description
                                        </p>

                                        <div class="btn-wrap">
                                             <a href="@Url.Action("Read", "Home", new { id = book.Id })"
                                                class="btn btn-outline-accent btn-accent-arrow">
                                                  Read Book <i class="icon icon-ns-arrow-right"></i>
                                             </a>
                                        </div>
                                   </div>

                                   <img src="@(string.IsNullOrEmpty(book.ImagePath) ? Url.Content("~/Content/Images/default.jpg") : book.ImagePath)"
                                        alt="@book.Title"
                                        class="banner-image">
                              </div>
                         }

                    </div>

                    <button class="next slick-arrow">
                         <i class="icon icon-arrow-right"></i>
                    </button>

               </div>
          </div>
     </div>
</section>

<section id="newest-books" class="py-4 my-4">
     <div class="container">
          <div class="row">
               <div class="col-md-12">

                    <div class="section-header align-center newest-header">
                         <div class="title">
                              <span>Latest Online Library Collection</span>
                         </div>

                         <h2 class="section-title">Newest Books</h2>

                         <div class="sort-container text-center mb-4">

                              <span class="sort-label">Sort by:</span>

                              <div class="sort-buttons">

                                   <a href="@Url.Action("Index", "Home", new { sortType = "title" })"
                                      class="sort-btn @(Request["sortType"] == "title" ? "active" : "")">
                                        Title
                                   </a>

                                   <a href="@Url.Action("Index", "Home", new { sortType = "id" })"
                                      class="sort-btn @(Request["sortType"] == "id" ? "active" : "")">
                                        Newest
                                   </a>

                                   <a href="@Url.Action("Index", "Home", new { sortType = "format" })"
                                      class="sort-btn @(Request["sortType"] == "format" ? "active" : "")">
                                        Format
                                   </a>

                              </div>

                         </div>
                    </div>
                    <div class="product-list newest-product-list" data-aos="fade-up">
                         <div class="row">
                              @foreach (var book in Model.FeaturedBooks.Take(8))
                              {
                                   <div class="col-md-3 mb-4">
                                        <div class="product-item newest-book-card">

                                             <figure class="product-style">
                                                  <img src="@(string.IsNullOrEmpty(book.ImagePath) ? Url.Content("~/Content/Images/default.jpg") : book.ImagePath)"
                                                       alt="@book.Title"
                                                       class="product-item newest-book-image">
                                             </figure>

                                             <figcaption>
                                                  <h3>@book.Title</h3>
                                                  <div><strong>Format:</strong> @book.FormatType</div>
                                                  <div><strong>Language:</strong> @book.Language</div>
                                                  <div><strong>Published Year:</strong> @book.PublishedYear</div>

                                                  <!-- 🔽 BUTON MIC DOWNLOAD -->
                                                  <div class="mt-3 text-center">
                                                       <a href="@Url.Action("AccessLoanResource", "Home", new {
                                resourceType = "ebook",
                                deliveryType = "download",
                                id = book.Id
                         })"
                                                          class="btn btn-sm btn-outline-dark">
                                                            Download
                                                       </a>
                                                  </div>

                                             </figcaption>

                                        </div>
                                   </div>
                              }
                         </div>
                    </div>
                    <div class="text-center mt-4">
                         <a href="@Url.Action("CompositeDemo", "Home")"
                            class="btn btn-outline-accent btn-accent-arrow px-4 py-2">
                              View All by Category <i class="icon icon-ns-arrow-right"></i>
                         </a>
                    </div>

               </div>
          </div>
     </div>
</section>


<section id="best-selling" class="leaf-pattern-overlay">
     <div class="corner-pattern-overlay"></div>
     <div class="container">
          <div class="row justify-content-center">

               <div class="col-md-8">

                    @if (Model.BestBook != null)
                    {
                         <div class="row">

                              <!-- Imagine -->
                              <div class="col-md-6">
                                   <figure class="products-thumb">
                                        <img src="@(string.IsNullOrEmpty(Model.BestBook.ImagePath) ? Url.Content("~/Content/Images/default.jpg") : Model.BestBook.ImagePath)"
                                             alt="@Model.BestBook.Title"
                                             class="single-image">
                                   </figure>
                              </div>

                              <!-- Text -->
                              <div class="col-md-6">
                                   <div class="product-entry">

                                        <h2 class="section-title divider">Best Borrowed Book</h2>
                                        <div class="products-content">

                                             <h3 class="item-title">@Model.BestBook.Title</h3>

                                             <p>
                                                  @Model.BestBook.Description
                                             </p>

                                             <div><strong>Language:</strong> @Model.BestBook.Language</div>
                                             <div><strong>Published:</strong> @Model.BestBook.PublishedYear</div>

                                             <div class="btn-wrap mt-3">
                                                  <a href="@Url.Action("Read", "Home", new { id = Model.BestBook.Id })"
                                                     class="btn-accent-arrow">
                                                       Read Book <i class="icon icon-ns-arrow-right"></i>
                                                  </a>
                                             </div>

                                        </div>

                                   </div>
                              </div>

                         </div>
                    }

               </div>

          </div>
     </div>
</section>

<section id="books-available" class="bookshelf py-5 my-5">
     <div class="container">
          <div class="row">
               <div class="col-md-12">

                    <div class="section-header align-center">
                         <div class="title">
                              <span>Browse our library collection</span>
                         </div>
                         <h2 class="section-title">Books Available</h2>
                    </div>

                    <div class="product-list">
                         <div class="row">

                              @foreach (var book in Model.FeaturedBooks)
                              {
                                   <div class="col-md-3 mb-4">
                                        <div class="product-item">

                                             <figure class="product-style">
                                                  <img src="@(string.IsNullOrEmpty(book.ImagePath) ? Url.Content("~/Content/Images/default.jpg") : book.ImagePath)"
                                                       alt="@book.Title"
                                                       class="product-item newest-book-image">
                                             </figure>

                                             <figcaption>
                                                  <h3>@book.Title</h3>
                                                  <div><strong>Category:</strong> @book.CategoryName</div>
                                                  <div><strong>Language:</strong> @book.Language</div>
                                                  <div><strong>Year:</strong> @book.PublishedYear</div>
                                             </figcaption>

                                        </div>
                                   </div>
                              }

                         </div>
                    </div>

               </div>
          </div>
     </div>
</section>
<a href="@Url.Action("DownloadPrototypeReport", "Home")"
   class="btn btn-warning">
     Download Report PDF
</a>
<script>
     function closeToast() {
          document.getElementById("success-toast")?.remove();
          document.getElementById("error-toast")?.remove();
     }

     setTimeout(function () {
          closeToast();
     }, 4000);
</script>
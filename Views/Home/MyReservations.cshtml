@model IEnumerable<OnlineLibrary.Models.Reservation>

@{
     ViewBag.Title = "My Reservations";
     Layout = "~/Views/Shared/_Layout.cshtml";
}

<section id="my-reservations" class="bookshelf py-5 my-5">
     <div class="container">

          <div class="section-header align-center">
               <div class="title">
                    <span>Your reserved books</span>
               </div>
               <h2 class="section-title">My Reservations</h2>
          </div>

          @if (!Model.Any())
          {
               <div class="text-center">
                    <p>You have no reservations yet.</p>

                    <a href="@Url.Action("Borrow", "Home")" class="btn borrow-btn">
                         Browse Books
                    </a>
               </div>
          }
          else
          {
               <div class="product-list">
                    <div class="row">

                         @foreach (var reservation in Model)
                         {
                              <div class="col-md-3 mb-4">
                                   <div class="product-item borrow-book-card">

                                        <figure class="product-style">
                                             <img src="@(reservation.Book == null || string.IsNullOrEmpty(reservation.Book.CoverImageUrl)
                                                  ? Url.Content("~/Content/Images/default.png")
                                                  : reservation.Book.CoverImageUrl)"
                                                  alt="@(reservation.Book == null ? "Book" : reservation.Book.Title)"
                                                  class="product-item borrow-book-image">
                                        </figure>

                                        <figcaption>
                                             <h3>
                                                  @(reservation.Book == null ? "Unknown Book" : reservation.Book.Title)
                                             </h3>

                                             <div>
                                                  <strong>Reserved:</strong>
                                                  @reservation.ReservedAt.ToString("dd.MM.yyyy")
                                             </div>

                                             <div>
                                                  <strong>Status:</strong>
                                                  <span class="text-warning">Reserved</span>
                                             </div>

                                             @using (Html.BeginForm("CancelReservation", "Home", FormMethod.Post))
                                             {
                                                  @Html.AntiForgeryToken()
                                                  <input type="hidden" name="id" value="@reservation.BookId" />

                                                  <button type="submit" class="borrow-card-btn return-card-btn">
                                                       Cancel Reservation
                                                  </button>
                                             }

                                        </figcaption>

                                   </div>
                              </div>
                         }

                    </div>
               </div>
          }

     </div>
</section>
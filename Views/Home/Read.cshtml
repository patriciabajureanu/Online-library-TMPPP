@{
     ViewBag.Title = "Read Book";
     Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5 my-5">
     <div class="container">
          <h2>@ViewBag.BookTitle</h2>

          <div class="alert alert-info">
               <p><strong>Adapter OpenBook:</strong> @ViewBag.OpenResult</p>
               <p><strong>Adapter GoToPage:</strong> @ViewBag.PageResult</p>
               <p><strong>Adapter CloseBook:</strong> @ViewBag.CloseResult</p>
          </div>

          <iframe src="@Url.Content(ViewBag.FilePath)"
                  width="100%"
                  height="700px"
                  style="border: 1px solid #ccc;">
          </iframe>
     </div>
</section>
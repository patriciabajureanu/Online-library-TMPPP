@{
     ViewBag.Title = "Library Categories";
     Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5 my-5">
     <div class="container">

          <div class="section-header align-center">
               <div class="title">
                    <span>Browse library by structure</span>
               </div>
               <h2 class="section-title">Categories, Authors and Books</h2>
          </div>

          @foreach (var category in ViewBag.Categories)
          {
               <div class="card mb-4 p-4 shadow-sm">
                    <h3>@category.Name</h3>

                    <p>
                         <strong>Total books:</strong> @category.GetTotalBooks()
                    </p>

                    <div class="library-tree">
                         @Html.Raw(category.Display())
                    </div>
               </div>
          }

     </div>
</section>